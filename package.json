{
  "name": "primeiro-milhao-dudi",
  "version": "1.0.0",
  "private": true,
  "description": "Primeiro Milhão: metas, rendas e gastos. App web (PWA) e Android (Capacitor).",
  "scripts": {
    "build:web": "node scripts/build-web.js",
    "android:add": "npx cap add android",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:icons": "npx capacitor-assets generate --android",
    "android:open": "npx cap open android",
    "serve": "npx http-server app -p 8080 -c-1"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
